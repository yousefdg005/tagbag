@echo off
chcp 65001 > nul
echo ======================================================================
echo    منظومة الرعاية المنزلية للعلاج الطبيعي - تشغيل المحاكي التفاعلي
echo ======================================================================
echo.
cd /d "%~dp0backend_nodejs"
echo [1/2] جاري تشغيل الخادم المحلي على المنفذ 3000...
start cmd /k "node server.js"
timeout /t 2 > nul
echo [2/2] جاري فتح المحاكي التفاعلي في المتصفح...
start http://localhost:3000
echo.
echo تم التشغيل بنجاح! يمكنك الآن تجربة البرامج الثلاثة معاً في المتصفح.
echo ======================================================================
pause
